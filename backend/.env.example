# Backend application
APP_NAME=Enterprise AI Agent Platform
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# AI model provider
MODEL_PROVIDER=mock
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=60

# Embedding provider (provider-neutral; optional local integration)
# Supported adapter in Phase 1.4-E: openai-compatible
EMBEDDING_PROVIDER=none
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_SECONDS=30

# Database / cache (reserved for local integration)
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent_platform
REDIS_URL=redis://localhost:6379/0

# Security - replace these values for non-local environments
JWT_SECRET_KEY=change-me-in-local-env
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
