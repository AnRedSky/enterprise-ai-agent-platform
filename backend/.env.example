# Backend application
APP_NAME=Enterprise AI Agent Platform
# The committed example is the zero-edit local development profile.
# It uses the Docker-published Ollama endpoint when available and the
# application-level MockProvider fallback when the local model is unavailable.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Environment file precedence: .env.example -> .env -> .env.local ->
# .env.${APP_ENV} -> .env.${APP_ENV}.local -> ENV_FILE. Process environment
# variables always have the highest precedence. No local file is required for
# the default development/test path.
ENV_FILE=

# Local Ollama chat provider. Docker must publish host port 11434.
# Current supported local chat model: qwen3:0.6b.
# If Ollama/model access fails, MODEL_FALLBACK_TO_MOCK=true makes the gateway
# return the deterministic MockProvider result instead of breaking local UI
# development. This fallback is not a real-provider quality result.
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_API_KEY=ollama
MODEL_DEFAULT_NAME=qwen3:0.6b
MODEL_TIMEOUT_SECONDS=60
MODEL_FALLBACK_TO_MOCK=true

# Retrieval defaults remain deterministic because the currently available
# Ollama embedding models do not match the current pgvector(1536) contract.
# Real embedding validation is an explicit opt-in configuration.
EMBEDDING_PROVIDER=mock
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=mock-semantic-v1
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_DIMENSION=1536
EMBEDDING_DIMENSIONS_PARAMETER_ENABLED=false
EMBEDDING_BATCH_SIZE=32

VECTOR_PROVIDER=pgvector
VECTOR_DB_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent_platform
VECTOR_DB_COLLECTION=knowledge_chunks
VECTOR_TOP_K=5
VECTOR_MIN_SCORE=0.0

DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent_platform
REDIS_URL=redis://localhost:6379/0

# Safe local development defaults only. Replace secrets in an untracked
# .env/.env.local for non-local environments.
JWT_SECRET_KEY=change-me-in-local-env
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
