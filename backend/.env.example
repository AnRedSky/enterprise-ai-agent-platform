# Backend application
APP_NAME=Enterprise AI Agent Platform
# The committed example is the zero-edit local development profile.
# It uses the Docker-published Ollama endpoint when available and the
# application-level MockProvider fallback when the local model is unavailable.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Environment file precedence: .env.example -> .env -> .env.local ->
# .env.${APP_ENV} -> .env.${APP_ENV}.local -> ENV_FILE. Process environment
# variables always have the highest precedence. No local file is required for
# the default development/test path.
ENV_FILE=

# Chat provider adapter and operator-defined provider/model metadata.
# Change these values for another compatible provider/model; the application
# does not depend on a specific chat model name.
MODEL_PROVIDER=openai-compatible
MODEL_PROVIDER_NAME=local-ollama
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_API_KEY=ollama
MODEL_DEFAULT_NAME=qwen3:0.6b
MODEL_TIMEOUT_SECONDS=60
MODEL_FALLBACK_TO_MOCK=true

# Embedding provider adapter and operator-defined provider/model metadata.
# Change EMBEDDING_MODEL, provider endpoint, and dimension together when using
# another embedding model. The dimension is validated against actual vectors.
EMBEDDING_PROVIDER=ollama
EMBEDDING_PROVIDER_NAME=local-ollama
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_DIMENSION=768
EMBEDDING_DIMENSIONS_PARAMETER_ENABLED=false
EMBEDDING_BATCH_SIZE=32

VECTOR_PROVIDER=pgvector
VECTOR_DB_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent_platform
VECTOR_DB_COLLECTION=knowledge_chunks
VECTOR_TOP_K=5
VECTOR_MIN_SCORE=0.0

# Retrieval evaluation defaults. CLI arguments override these for one run;
# unset CLI arguments always resolve back to these application defaults.
RETRIEVAL_EVALUATION_TOP_K=3
RETRIEVAL_EVALUATION_MIN_SCORE=0.0
RETRIEVAL_EVALUATION_MIN_RECALL_AT_K=
RETRIEVAL_EVALUATION_MIN_PRECISION_AT_K=
RETRIEVAL_EVALUATION_MIN_MRR=
RETRIEVAL_EVALUATION_MIN_CITATION_CORRECTNESS=
RETRIEVAL_EVALUATION_MAX_ERROR_RATE=0.0

DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent_platform
REDIS_URL=redis://localhost:6379/0

# Safe local development defaults only. Replace secrets in an untracked
# .env/.env.local for non-local environments.
JWT_SECRET_KEY=change-me-in-local-env
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
