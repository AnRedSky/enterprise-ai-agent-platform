# Backend application
APP_NAME=Enterprise AI Agent Platform
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173
ENV_FILE=

MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_API_KEY=ollama
MODEL_DEFAULT_NAME=qwen3:0.6b
MODEL_TIMEOUT_SECONDS=60
MODEL_FALLBACK_TO_MOCK=true

EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_DIMENSION=768
EMBEDDING_DIMENSIONS_PARAMETER_ENABLED=false
EMBEDDING_BATCH_SIZE=32

VECTOR_PROVIDER=pgvector
VECTOR_DB_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent_platform
VECTOR_DB_COLLECTION=knowledge_chunks
VECTOR_TOP_K=5
VECTOR_MIN_SCORE=0.0

DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent_platform
REDIS_URL=redis://localhost:6379/0
SCHEDULER_POLL_INTERVAL_SECONDS=5

# Webhook Delivery Worker：单进程 in-flight 上限与轮询/lease/retry 参数。
# 不创建无界任务队列；并发度同时构成 backpressure 边界。
WEBHOOK_WORKER_CONCURRENCY=4
WEBHOOK_WORKER_POLL_INTERVAL=0.2
WEBHOOK_WORKER_LEASE_SECONDS=60
WEBHOOK_WORKER_MAX_ATTEMPTS=5
# 可选租户隔离：为空表示保持全租户 Worker；设置后仅 Claim 指定 tenant。
WEBHOOK_WORKER_TENANT_ID=
# Consumer group 隔离：同组竞争、异组互不 Claim。生产默认 default；Acceptance 使用独立临时 group。
WEBHOOK_WORKER_CONSUMER_GROUP=default

# Multi-Agent Collaboration 治理默认值；真实环境可在未提交 .env/.env.local 中覆盖。
MULTI_AGENT_MAX_DELEGATION_DEPTH=3
MULTI_AGENT_MAX_ACTIVE_DELEGATIONS=4
MULTI_AGENT_TIMEOUT_SECONDS=300
MULTI_AGENT_MODEL_BUDGET={}

JWT_SECRET_KEY=change-me-in-local-env
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
