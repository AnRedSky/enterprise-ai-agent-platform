# Backend application
APP_NAME=Enterprise AI Agent Platform
# Environment selection: development / test / staging / production.
# Set APP_ENV in the process environment when selecting a non-development file.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Layered environment files (lowest -> highest precedence):
# .env -> .env.local -> .env.${APP_ENV} -> .env.${APP_ENV}.local -> ENV_FILE
# Process environment variables always have the highest precedence.
# Optional explicit deployment file, e.g. ENV_FILE=/run/secrets/agent.env
ENV_FILE=

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# AI model provider
MODEL_PROVIDER=mock
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=60

# Embedding provider (provider-neutral)
# `mock` is deterministic and offline; use it for local/test vector pipeline validation.
# `openai-compatible` is reserved for real provider validation when credentials are available.
EMBEDDING_PROVIDER=mock
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=mock-semantic-v1
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_DIMENSION=1536
# Maximum number of chunks sent to the embedding API per request.
EMBEDDING_BATCH_SIZE=32

# Vector retrieval provider
# Use pgvector for local/test PostgreSQL vector validation.
VECTOR_PROVIDER=pgvector
VECTOR_DB_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent_platform
VECTOR_DB_COLLECTION=knowledge_chunks
VECTOR_TOP_K=5
VECTOR_MIN_SCORE=0.0

# Docker Compose PostgreSQL image. The default image includes pgvector for PG16.
POSTGRES_IMAGE=pgvector/pgvector:pg16

# Database / cache
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent_platform
REDIS_URL=redis://localhost:6379/0

# Security - replace these values for non-local environments
JWT_SECRET_KEY=change-me-in-local-env
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
