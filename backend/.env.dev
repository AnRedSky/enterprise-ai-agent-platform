# Local development profile
#
# This file is intentionally safe to commit: it contains only local service
# endpoints and non-secret compatibility values. Do not add real credentials.
#
# Activate it for local development by copying it to backend/.env.local, or by
# setting ENV_FILE=.env.dev in the process environment.

APP_NAME=Enterprise AI Agent Platform
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Ollama chat model (Docker-published to the host at localhost:11434).
# The API accepts the model name per request; use qwen3:0.6b in Agent/Runtime
# requests while this local profile is active.
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_API_KEY=ollama
MODEL_TIMEOUT_SECONDS=60

# Keep retrieval embeddings on the deterministic local provider for the
# development profile. The currently available Ollama embedding models are
# 768/1024-dimensional while the current pgvector contract is vector(1536).
# Do not silently change dimensions, truncate, or pad vectors in this profile.
# Phase 2.2-C real embedding validation remains an explicit opt-in test setup.
EMBEDDING_PROVIDER=mock
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=mock-semantic-v1
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_DIMENSION=1536
EMBEDDING_DIMENSIONS_PARAMETER_ENABLED=false
EMBEDDING_BATCH_SIZE=32

VECTOR_PROVIDER=pgvector
VECTOR_DB_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent_platform
VECTOR_DB_COLLECTION=knowledge_chunks
VECTOR_TOP_K=5
VECTOR_MIN_SCORE=0.0

DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent_platform
REDIS_URL=redis://localhost:6379/0

# Local-only development defaults. Replace only in an untracked .env/.env.local
# for environments that require real secrets.
JWT_SECRET_KEY=change-me-in-local-env
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
