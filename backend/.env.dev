# Local development profile
# Safe to commit: local service endpoints and compatibility values only.
# The same settings are now represented by backend/.env.example, which is the
# zero-edit default for fresh development/test checkouts.

APP_NAME=Enterprise AI Agent Platform
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Ollama chat model published from Docker to localhost:11434.
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_API_KEY=ollama
MODEL_DEFAULT_NAME=qwen3:0.6b
MODEL_TIMEOUT_SECONDS=60
MODEL_FALLBACK_TO_MOCK=true

# Keep retrieval deterministic until an embedding model matching the current
# pgvector(1536) contract is explicitly validated.
EMBEDDING_PROVIDER=mock
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=mock-semantic-v1
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_DIMENSION=1536
EMBEDDING_DIMENSIONS_PARAMETER_ENABLED=false
EMBEDDING_BATCH_SIZE=32

VECTOR_PROVIDER=pgvector
VECTOR_DB_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent_platform
VECTOR_DB_COLLECTION=knowledge_chunks
VECTOR_TOP_K=5
VECTOR_MIN_SCORE=0.0

DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent_platform
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-in-local-env
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
